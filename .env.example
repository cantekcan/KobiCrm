# Bu dosyayı ".env" olarak kopyalayın ve DEĞERLERİ KENDİNİZ DOLDURUN. ".env" dosyası git'e eklenmez.
# Burada gerçek parola/anahtar YOKTUR; aşağıdaki değerler yer tutucudur.

# --- Veritabanı (PostgreSQL) ---
POSTGRES_DB=suttcrm
POSTGRES_USER=suttcrm
POSTGRES_PASSWORD=BURAYA_UZUN_BIR_PAROLA_YAZIN
POSTGRES_PORT=5433

# --- Uygulama ---
# En az 32 karakterlik rastgele bir anahtar (örnek üretim: openssl rand -base64 48)
JWT_KEY=BURAYA_EN_AZ_32_KARAKTERLIK_RASTGELE_ANAHTAR_YAZIN
# İlk kurulumda oluşturulacak yönetici. Parola en az 10 karakter olmalı; yer tutucu değerle uygulama başlamaz.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=BURAYA_GUCLU_BIR_PAROLA_YAZIN
API_PORT=5080
ASPNETCORE_ENVIRONMENT=Production

# --- e-Arşiv ağ geçidi (GİB e-Arşiv Portalı; docs/invoice-integration.md) ---
# docker compose --profile app --profile gateway up -d --build   ile çalışır.
# GİB TEST portalında doğrulanmadan GIB_ENV=PROD YAPMAYIN.
GATEWAY_TOKEN=BURAYA_EN_AZ_32_KARAKTERLIK_RASTGELE_ANAHTAR_YAZIN
INVOICE_GATEWAY_URL=http://gateway:5090
GIB_ENV=TEST
GIB_USER=BURAYA_GIB_KULLANICI_KODU
GIB_PASSWORD=BURAYA_GIB_PAROLASI
# PROD için ayrıca (bilerek): GIB_ALLOW_PROD=yes  ve  INVOICE_LIVE_SENDING=true
GIB_ALLOW_PROD=no
INVOICE_LIVE_SENDING=false
